/*
  cache-control: public,max-age=300
  X-Frame-Options: SAMEORIGIN
  X-XSS-Protection: 1; mode=block
  X-Content-Type-Options: nosniff
  Strict-Transport-Security: max-age=31536000
  Content-Security-Policy: default-src 'self'; frame-ancestors 'none'; object-src 'none'; script-src 'self' https://static.cloudflareinsights.com https://ajax.cloudflare.com; connect-src 'self' https://cloudflareinsights.com; style-src 'self'; img-src 'self' data:; frame-src: 'none'
