{
	"name": "haiku-laureate",
	"version": "1.0.3",
	"private": true,
	"description": "A geolocated haiku generator.",
	"keywords": [
		"itp",
		"geolocated",
		"flickr",
		"haiku",
		"poetry",
		"generative"
	],
	"homepage": "https://frontiernerds.com/projects/haiku-laureate",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/kitschpatrol/haiku-laureate.git"
	},
	"license": "UNLICENSED",
	"author": {
		"name": "Eric Mika",
		"email": "eric@ericmika.com",
		"url": "https://ericmika.com"
	},
	"type": "module",
	"scripts": {
		"clean": "shx rm -f pnpm-lock.yaml && git clean -fdX -e !.claude/",
		"fix": "ksc fix",
		"init": "op inject -i .template.env -o .env && op inject -i archive/app/.template.credentials.cfg -o archive/app/credentials.cfg",
		"lint": "ksc lint",
		"test": "vitest run"
	},
	"dependencies": {
		"@netlify/functions": "^5.3.0",
		"dotenv": "^17.4.2",
		"flickr-sdk": "^6.3.0",
		"lodash": "^4.18.1",
		"node-geocoder": "^4.4.1",
		"syllable": "^5.0.1"
	},
	"devDependencies": {
		"@kitschpatrol/dict-en-wiktionary": "^1.5.0",
		"@kitschpatrol/shared-config": "^8.5.0",
		"@types/lodash": "^4.17.24",
		"@types/node": "~24.13.3",
		"@types/node-geocoder": "^4.2.6",
		"shx": "^0.4.0",
		"typescript": "~6.0.3",
		"vitest": "^4.1.10"
	},
	"packageManager": "pnpm@11.1.2",
	"engines": {
		"node": ">=24.16.0"
	}
}
