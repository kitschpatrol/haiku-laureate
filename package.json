{
	"name": "haiku-laureate",
	"version": "1.0.1",
	"type": "module",
	"description": "A geolocated haiku generator.",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/kitschpatrol/haiku-laureate.git"
	},
	"homepage": "https://frontiernerds.com/projects/haiku-laureate",
	"author": {
		"name": "Eric Mika",
		"email": "eric@ericmika.com",
		"url": "https://ericmika.com"
	},
	"license": "Unlicensed",
	"private": true,
	"packageManager": "pnpm@9.9.0",
	"engines": {
		"node": ">=20.0.0",
		"pnpm": ">=9.0.0"
	},
	"keywords": [
		"itp",
		"geolocated",
		"flickr",
		"haiku",
		"poetry",
		"generative"
	],
	"scripts": {
		"clean": "rimraf ./pnpm-lock.yaml ; mv .env temp1 ; mv ./archive/app/credentials.cfg temp2 ;  git clean -fdX ; mv temp1 .env ; mc mv temp2 ./archive/app/credentials.cfg",
		"fix": "shared-config --fix",
		"lint": "shared-config --lint",
		"test": "vitest"
	},
	"dependencies": {
		"@netlify/functions": "^2.8.1",
		"dotenv": "^16.4.5",
		"flickr-sdk": "^6.3.0",
		"lodash": "^4.17.21",
		"node-geocoder": "^4.4.0",
		"syllable": "^5.0.1"
	},
	"devDependencies": {
		"@kitschpatrol/shared-config": "^4.7.5",
		"@types/lodash": "^4.17.7",
		"@types/node": "^20.16.5",
		"@types/node-geocoder": "^4.2.6",
		"netlify-cli": "^17.35.0",
		"rimraf": "^6.0.1",
		"typescript": "^5.5.4",
		"vitest": "^2.0.5"
	}
}
