{
	"name": "haiku-laureate",
	"version": "1.0.1",
	"type": "module",
	"description": "A geolocated haiku generator.",
	"repository": "github:kitschpatrol/haiku-laureate",
	"homepage": "https://frontiernerds.com/projects/haiku-laureate",
	"author": {
		"name": "Eric Mika",
		"email": "eric@ericmika.com",
		"url": "https://ericmika.com"
	},
	"license": "Unlicensed",
	"private": true,
	"packageManager": "pnpm@9.10.0",
	"engines": {
		"node": ">=20.0.0",
		"pnpm": ">=9.0.0"
	},
	"keywords": [
		"itp",
		"geolocated",
		"flickr",
		"haiku",
		"poetry",
		"generative"
	],
	"scripts": {
		"clean": "git rm -f pnpm-lock.yaml ; mv .env temp1 ; mv ./archive/app/credentials.cfg temp2 ;  git clean -fdX ; mv temp1 .env ; mv temp2 ./archive/app/credentials.cfg",
		"fix": "shared-config --fix",
		"lint": "shared-config --lint",
		"test": "vitest"
	},
	"dependencies": {
		"@netlify/functions": "^2.8.1",
		"dotenv": "^16.4.5",
		"flickr-sdk": "^6.3.0",
		"lodash": "^4.17.21",
		"node-geocoder": "^4.4.0",
		"syllable": "^5.0.1"
	},
	"devDependencies": {
		"@kitschpatrol/dict-en-wiktionary": "^1.0.2",
		"@kitschpatrol/shared-config": "^4.7.9",
		"@types/lodash": "^4.17.7",
		"@types/node": "20.0.0",
		"@types/node-geocoder": "^4.2.6",
		"typescript": "^5.6.2",
		"vitest": "^2.1.1"
	}
}
