{
	"name": "haiku-laureate",
	"version": "1.0.5",
	"private": true,
	"description": "A geolocated haiku generator.",
	"keywords": [
		"itp",
		"geolocated",
		"flickr",
		"haiku",
		"poetry",
		"generative"
	],
	"homepage": "https://frontiernerds.com/projects/haiku-laureate",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/kitschpatrol/haiku-laureate.git"
	},
	"license": "CC-BY-NC-SA-4.0",
	"author": {
		"name": "Eric Mika",
		"email": "eric@ericmika.com",
		"url": "https://ericmika.com"
	},
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"main": "./dist/index.js",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"scripts": {
		"build": "tsdown --tsconfig tsconfig.build.json --platform neutral --dts",
		"clean-deep": "shx rm -f pnpm-lock.yaml && git clean -fdX -e !.claude/",
		"deploy": "wrangler deploy --secrets-file .env",
		"dev": "wrangler dev --env-file .env --upstream-protocol https",
		"fix": "ksc fix",
		"init": "op inject -i .template.env -o .env && op inject -i archive/app/.template.credentials.cfg -o archive/app/credentials.cfg",
		"lint": "ksc lint",
		"prepare": "skills experimental_sync -y -f",
		"release": "bumpp --commit 'Release: %s'",
		"test": "vitest run"
	},
	"dependencies": {
		"flickr-sdk": "^7.1.0",
		"lodash": "^4.18.1",
		"syllable": "^5.0.1"
	},
	"devDependencies": {
		"@kitschpatrol/dict-en-wiktionary": "^1.6.0",
		"@kitschpatrol/shared-config": "^8.13.1",
		"@types/lodash": "^4.17.26",
		"@types/node": "~24.13.6",
		"bumpp": "^12.3.0",
		"dotenv": "^18.0.7",
		"shx": "^0.4.0",
		"skills": "^1.7.2",
		"tsdown": "^0.23.1",
		"typescript": "~6.0.3",
		"vitest": "^5.0.3",
		"wrangler": "^4.149.0"
	},
	"packageManager": "pnpm@12.11.2",
	"engines": {
		"node": "^24.16.0 || >=26.3.0"
	}
}
